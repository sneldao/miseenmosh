#!/bin/sh
# MISE EN MOSH pre-commit: secret scan on staged changes, then lint/format
# staged web files if tooling exists. Activate per-clone with:
#   git config core.hooksPath .githooks
set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/' || true)
[ -z "$STAGED_FILES" ] && exit 0

# --- secrets scan: gitleaks if available, regex fallback otherwise ---
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --no-banner --log-level error >/dev/null 2>&1; then
    echo "❌ pre-commit: gitleaks found a possible secret in staged changes."
    gitleaks protect --staged --no-banner 2>&1 | head -15
    exit 1
  fi
else
  PATTERNS='sk_live_|rk_live_|sk_test_|rk_test_|ghp_|gho_|github_pat_|xox[baprs]-|AKIA[0-9A-Z]{16}|tvly-[a-z]+-|-----BEGIN [A-Z ]*PRIVATE KEY|api[_-]?key["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9_\-]{20,}|password["'"'"' ]*[:=]["'"'"' ]*[^"'"'"' ]{8,}|Bearer [A-Za-z0-9_\-\.]{20,}'
  if echo "$STAGED_FILES" | while read -r f; do git show ":$f" 2>/dev/null; done | grep -nEi "$PATTERNS" >/dev/null 2>&1; then
    echo "❌ pre-commit: possible secret detected in staged changes."
    git diff --cached -- $STAGED_FILES | grep -nEi "$PATTERNS" | head -5
    exit 1
  fi
fi

# --- eslint staged JS/TS if the project has it configured ---
if [ -d node_modules ] && ls .eslintrc* eslint.config.* >/dev/null 2>&1; then
  JS_STAGED=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
  if [ -n "$JS_STAGED" ]; then
    echo "$JS_STAGED" | xargs npx --no-install eslint || {
      echo "❌ pre-commit: eslint failed on staged files."
      exit 1
    }
  fi
fi

# --- prettier staged web files if installed ---
if [ -d node_modules ] && [ -f package.json ]; then
  WEB_STAGED=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|css|html|json|md)$' || true)
  if [ -n "$WEB_STAGED" ]; then
    echo "$WEB_STAGED" | xargs npx --no-install prettier --write --ignore-unknown >/dev/null 2>&1 || true
    echo "$WEB_STAGED" | xargs git add -- 2>/dev/null || true
  fi
fi
exit 0
